{
  "name": "@aegis/resilience-service",
  "version": "0.1.0",
  "private": true,
  "description": "Independent operational-resilience service: recovery drill evidence, backup-set registry and recovery readiness.",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "prisma generate && eslint \"{src,test,scripts}/**/*.ts\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && jest --runInBand && node --test \"scripts/*.test.mjs\"",
    "test:tooling": "node --test \"scripts/*.test.mjs\"",
    "test:integration": "prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-integration.json --runInBand",
    "reconcile": "node scripts/reconcile.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "backup:verify:negative": "node scripts/backup-negative.mjs",
    "restore:verify": "node scripts/restore-verify.mjs",
    "drill": "node scripts/drill.mjs",
    "clean": "node -e \"const fs=require('node:fs');for(const path of ['dist','coverage','tsconfig.tsbuildinfo','src/generated'])fs.rmSync(path,{recursive:true,force:true})\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@aegis/contracts": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.20.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "17.0.0",
    "jest": "30.1.3",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testEnvironment": "node"
  }
}
