# AEGIS Shield local development configuration
# Copy this file to a local .env file when implementation begins.
# Every value below is fake and must be replaced only in an ignored local file.

# Application ports
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_GATEWAY_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_CSRF_COOKIE_NAME=aegis_csrf
IDENTITY_SERVICE_PORT=4101
IDENTITY_PORT=4101
IDENTITY_HOST=127.0.0.1
IDENTITY_SERVICE_URL=http://127.0.0.1:4101
LEDGER_SERVICE_PORT=4102
LEDGER_HOST=127.0.0.1
LEDGER_SERVICE_URL=http://127.0.0.1:4102
PAYMENTS_SERVICE_PORT=4104
PAYMENTS_HOST=127.0.0.1
PAYMENTS_SERVICE_URL=http://127.0.0.1:4104
RISK_SERVICE_PORT=4105
RISK_HOST=127.0.0.1
RISK_SERVICE_URL=http://127.0.0.1:4105

# PostgreSQL (local development only)
# Change every password below in your ignored .env file before starting Docker.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_DATABASE=postgres
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis-local-admin-change-me
DATABASE_URL=postgresql://aegis_admin:aegis-local-admin-change-me@127.0.0.1:5432/postgres

IDENTITY_DB_NAME=aegis_identity
IDENTITY_DB_USER=aegis_identity
IDENTITY_DB_PASSWORD=aegis-local-identity-change-me
IDENTITY_DATABASE_URL=postgresql://aegis_identity:aegis-local-identity-change-me@127.0.0.1:5432/aegis_identity?schema=app

LEDGER_DB_NAME=aegis_ledger
LEDGER_DB_USER=aegis_ledger
LEDGER_DB_PASSWORD=aegis-local-ledger-change-me
LEDGER_DATABASE_URL=postgresql://aegis_ledger:aegis-local-ledger-change-me@127.0.0.1:5432/aegis_ledger?schema=app

PAYMENTS_DB_NAME=aegis_payments
PAYMENTS_DB_USER=aegis_payments
PAYMENTS_DB_PASSWORD=aegis-local-payments-change-me
PAYMENTS_DATABASE_URL=postgresql://aegis_payments:aegis-local-payments-change-me@127.0.0.1:5432/aegis_payments?schema=app

AUDIT_DB_NAME=aegis_audit
AUDIT_DB_USER=aegis_audit
AUDIT_DB_PASSWORD=aegis-local-audit-change-me
AUDIT_DATABASE_URL=postgresql://aegis_audit:aegis-local-audit-change-me@127.0.0.1:5432/aegis_audit
RISK_DATABASE_URL=postgresql://aegis_audit:aegis-local-audit-change-me@127.0.0.1:5432/aegis_audit?schema=app

# Redis (local development only; change the password in your ignored .env file)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=aegis-local-redis-change-me
REDIS_URL=redis://:aegis-local-redis-change-me@127.0.0.1:6379/0
IDENTITY_REDIS_PREFIX=aegis:identity:
# Each service namespaces its own Redis keyspace so channel, session, replay and
# risk state cannot collide in the single shared instance.
PAYMENTS_REDIS_PREFIX=aegis:payments:
RISK_REDIS_PREFIX=aegis:risk:

# Identity authentication (local development only; rotate every secret locally)
IDENTITY_INTERNAL_TOKEN=local-only-internal-token-change-me
AUTH_SESSION_COOKIE_NAME=aegis_session
AUTH_CSRF_COOKIE_NAME=aegis_csrf
AUTH_SESSION_IDLE_TTL_SECONDS=900
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=28800
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_HOUR=5
DEMO_AUTH_ENABLED=true
WEBAUTHN_RP_NAME=AEGIS Shield
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
FIELD_ENCRYPTION_KEY=BASE64_LOCAL_ONLY_32_BYTE_KEY_PLACEHOLDER

# Accounts and double-entry ledger (local development only)
# LEDGER_INTERNAL_TOKEN authenticates the API Gateway to the Ledger service and
# must never be exposed to a browser or prefixed with NEXT_PUBLIC_.
LEDGER_INTERNAL_TOKEN=local-only-ledger-token-change-me
LEDGER_DEFAULT_CURRENCY=LKR
LEDGER_HTTP_TIMEOUT_MS=5000
LEDGER_IDEMPOTENCY_RETENTION_HOURS=24
LEDGER_MAX_POSTING_RETRIES=3

# Customer transfers (local development only)
PAYMENTS_INTERNAL_TOKEN=local-only-payments-token-change-me
PAYMENTS_MIN_TRANSFER_MINOR=100
PAYMENTS_MAX_TRANSFER_MINOR=5000000
PAYMENTS_DAILY_OUTGOING_LIMIT_MINOR=10000000
PAYMENTS_INTENT_TTL_SECONDS=300
PAYMENTS_HTTP_TIMEOUT_MS=5000
PAYMENTS_RECOVERY_STALE_SECONDS=30
PAYMENTS_MAX_PROCESSING_ATTEMPTS=5
PAYMENTS_IDEMPOTENCY_RETENTION_HOURS=24
PAYMENTS_QR_SIGNING_KEY=local-only-qr-signing-key-change-me
PAYMENTS_QR_DYNAMIC_TTL_SECONDS=300
PAYMENTS_QR_STATIC_TTL_HOURS=8760
USSD_PROVIDER_SECRET=local-only-ussd-secret-change-me
TRANSFER_STEP_UP_MAX_ATTEMPTS=5
TRANSFER_STEP_UP_LOCK_SECONDS=300

# JWT signing
JWT_ISSUER=aegis-shield-local
JWT_AUDIENCE=aegis-shield-services
JWT_PRIVATE_KEY_PATH=./certs/local/example-jwt-private.pem
JWT_PUBLIC_KEY_PATH=./certs/local/example-jwt-public.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Service-to-service authentication
SERVICE_AUTH_ISSUER=aegis-shield-local
SERVICE_AUTH_AUDIENCE=aegis-shield-internal
SERVICE_AUTH_SHARED_SECRET=example-only-not-a-secret

# Threat detection, risk and automated controls (local development only)
RISK_INTERNAL_TOKEN=local-only-risk-internal-token-change-me
RISK_GATEWAY_SOURCE_TOKEN=local-only-risk-gateway-source-change-me
RISK_IDENTITY_SOURCE_TOKEN=local-only-risk-identity-source-change-me
RISK_PAYMENTS_SOURCE_TOKEN=local-only-risk-payments-source-change-me
RISK_LEDGER_SOURCE_TOKEN=local-only-risk-ledger-source-change-me
RISK_INFRASTRUCTURE_SOURCE_TOKEN=local-only-risk-infrastructure-source-change-me
RISK_CHANNEL_SOURCE_TOKEN=local-only-risk-channel-source-change-me
RISK_HTTP_TIMEOUT_MS=2000
RISK_EVENT_RETENTION_DAYS=90
RISK_ASSESSMENT_TTL_SECONDS=300
RISK_SOURCE_STALE_SECONDS=900
RISK_OPERATOR_SESSION_TTL_SECONDS=1800
RISK_HIGH_VALUE_MINOR=10000000
RISK_CUMULATIVE_VALUE_MINOR=25000000
# Optional and development-only. Generate a local random value; never enable in production.
# RISK_OPERATOR_BOOTSTRAP_TOKEN=

# SABCL metadata protection (Security-Aware Blind Communication Layer)
#
# Mode:
#   strict      every integrated call is encrypted and routed; startup fails if
#               keys or routes are missing, invalid, placeholders or test
#               fixtures. This is what CI runs.
#   compatible  SABCL is used when it can be, with a documented fallback to the
#               direct internal path. Refused when NODE_ENV=production.
#   off         SABCL is not wired in; existing behaviour is unchanged.
#
# There is no automatic downgrade from strict. A router outage in strict mode is
# an outage, never a plaintext retry.
#
# Defaults to `off` so that a fresh copy of this file starts a working stack.
# The key values below are placeholders and are not valid key material: set
# `strict` or `compatible` only after generating real keys, or startup will fail.
#   pnpm sabcl:keys -- --service gateway --version 1
#   pnpm sabcl:keys -- --route-secret
# Full walkthrough: docs/demo/sabcl-routing-demo.md
SABCL_MODE=off

# The blind router. Port 4103 is the unclaimed gap between the Ledger (4102) and
# Payments (4104) services; 4105 is reserved for threat detection.
SABCL_ROUTER_PORT=4103
SABCL_ROUTER_HOST=127.0.0.1
SABCL_ROUTER_URL=http://127.0.0.1:4103
SABCL_HTTP_TIMEOUT_MS=8000
SABCL_FORWARD_TIMEOUT_MS=5000
SABCL_RATE_LIMIT_PER_MINUTE=600
SABCL_MAX_ENVELOPE_BYTES=262144
SABCL_REDIS_PREFIX=aegis:sabcl:

# Shared secret from which opaque route tokens are derived. Must decode to at
# least 32 bytes. Generate one with:
#   pnpm --filter @aegis/sabcl keys:generate -- --route-secret
SABCL_ROUTE_SECRET=BASE64URL_LOCAL_ONLY_32_BYTE_ROUTE_SECRET_PLACEHOLDER

# Per-service identities. Generate a set with:
#   pnpm --filter @aegis/sabcl keys:generate -- --service gateway --version 1
# Every value below is a placeholder and is refused in strict mode. Private keys
# belong in an ignored local .env or a secret store, never in this file and
# never in a commit.
SABCL_GATEWAY_KEY_ID=gateway.v1
SABCL_GATEWAY_ENCRYPTION_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_X25519_PRIVATE_PLACEHOLDER
SABCL_GATEWAY_SIGNING_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_ED25519_PRIVATE_PLACEHOLDER

SABCL_IDENTITY_KEY_ID=identity.v1
SABCL_IDENTITY_ENCRYPTION_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_X25519_PRIVATE_PLACEHOLDER
SABCL_IDENTITY_SIGNING_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_ED25519_PRIVATE_PLACEHOLDER

SABCL_LEDGER_KEY_ID=ledger.v1
SABCL_LEDGER_ENCRYPTION_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_X25519_PRIVATE_PLACEHOLDER
SABCL_LEDGER_SIGNING_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_ED25519_PRIVATE_PLACEHOLDER

SABCL_PAYMENTS_KEY_ID=payments.v1
SABCL_PAYMENTS_ENCRYPTION_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_X25519_PRIVATE_PLACEHOLDER
SABCL_PAYMENTS_SIGNING_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_ED25519_PRIVATE_PLACEHOLDER

SABCL_ROUTER_KEY_ID=sabcl-router.v1
SABCL_ROUTER_ENCRYPTION_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_X25519_PRIVATE_PLACEHOLDER
SABCL_ROUTER_SIGNING_PRIVATE_KEY=BASE64URL_LOCAL_ONLY_ED25519_PRIVATE_PLACEHOLDER

# Public half of every identity, as a JSON array. Each service needs the peers
# it talks to; the same list on every service is simplest for local development.
# Rotation is adding the next version here first, then switching the owning
# service over. See docs/security/sabcl-key-management.md.
SABCL_PEERS=[{"keyId":"gateway.v1","encryptionPublicKey":"BASE64URL_PUBLIC_PLACEHOLDER","signingPublicKey":"BASE64URL_PUBLIC_PLACEHOLDER"}]

# Route table. Omit to use the local defaults derived from the service URLs
# above. A destination is reachable only if it appears here; there is no
# wildcard and no request-supplied URL.
# SABCL_ROUTES=[{"routeId":"ledger.accounts","service":"ledger","destination":"http://127.0.0.1:4102"}]

# Observability
LOG_LEVEL=debug
OTEL_SERVICE_NAME=aegis-shield-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9090
